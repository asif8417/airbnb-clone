<% layout ("/layouts/boilerplate") %>

    <div class="row mt-2">
        <div class="col-8 offset-2">

            
                <form method="POST" 
                action="/listings"
                    novalidate class="needs-validation" 
                    enctype="multipart/form-data">
                    <div>
                        <label for="title" class="form-label">Title</label><br>
                        <input name="listing[title]" class="form-control" placeholder="enter title" type="text"
                            required>
                        <div class="valid-feedback">
                            Looks good!
                        </div>
                    </div>
                    <br>
                    <div>
                        <label for="description" class="form-label">Description</label>
                        <textarea name="listing[description]" class="form-control" placeholder="enter description"
                            required></textarea>
                        <div class="invalid-feedback">
                            description should be valid
                        </div>
                    </div>
                    <br>
                    <div>
                        <label for="image"
                        class="form-label">Upload Image</label>
                        <input name="listing[image]"
                        class="form-control"
                        placeholder="enter image URL/Link"
                        type="file">
                    </div>
                    <br>
                    <div class="row">
                        <div class="col-4">
                            <div>
                                <label for="price" class="form-label">Price</label>
                                <input  name="listing[price]" class="form-control" placeholder="enter price" required>
                                <div class="invalid-feedback">
                                    price should be valid
                                </div>
                            </div>

                        </div>

                        <br>
                        <div class="col-md-8">

                            <div>
                                <label for="location" class="form-label">Location</label>
                                <input type="text" name="listing[location]" class="form-control"
                                    placeholder="enter location" required>
                                <div class="invalid-feedback">
                                    Location should be valid
                                </div>
                            </div>

                        </div>

                        <br>

                    </div>
                    
                    <div class="mt-md-2">
                        <label for="country" class="form-label">Country</label>
                        <select
        name="listing[country]"
        id="country"
        class="form-select"
        required
    >
        <option value="" selected disabled>
            Select Country
        </option>

        <% countries.forEach(country => { %>
            <option value="<%= country %>">
                <%= country %>
            </option>
        <% }) %>

    </select>
                        
                        <div class="invalid-feedback">
                            country should be valid
                        </div>
                    </div>
                    <br>
                    <button class="btn btn-dark add-btn">Add</button>
                </form>
        </div>
    </div>
